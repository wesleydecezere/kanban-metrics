{
  "schema": "node_modules/@octokit/graphql-schema/schema.json",
  "documents": "./**/*.graphql",
  "extensions": {
    "codegen": {
      "generates": {
        "src/graphql/generated/types.ts": {
          "plugins": [
            "typescript",
            "typescript-resolvers",
            "typescript-document-nodes",
            "typed-document-node",
            "typescript-operations"
          ]
        }
      }
    }
  }
}
