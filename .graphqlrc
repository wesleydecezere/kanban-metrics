{
  "schema": "node_modules/@octokit/graphql-schema/schema.json",
  "documents": "./**/*.gql",
  "extensions": {
    "codegen": {
      "generates": {
        "src/generated/graphql/types.ts": {
          "plugins": [
            "typescript",
            "typescript-resolvers",
            "typescript-operations",
            "typed-document-node"
          ]
        }
      }
    }
  }
}
