{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.[tj]s$": ["ts-jest"]
  },
  "testMatch": ["**/*.test.ts"],
  "transformIgnorePatterns": ["<rootDir>/node_modules/?!chalk"],
  "setupFilesAfterEnv": ["<rootDir>/test/index.ts"]
}
