{
  "name": "kanban-metrics-backend",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json\" --exec \" ts-node ./src/index.ts\"",
    "build": "tsc",
    "nvm:latest": ". $NVM_DIR/nvm.sh && nvm install --lts && nvm alias latest lts/* && nvm use latest",
    "start": "yarn nvm:latest && ts-node ./src/index.ts",
    "migrate": "yarn nvm:latest && npx prisma migrate dev",
    "lint": "eslint . --ext .js --ext .ts --ext .gql --ext .graphql",
    "lint:fix": "yarn lint -- --fix",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-eslint/eslint-plugin": "^3.20.1",
    "@octokit/graphql-schema": "^14.42.0",
    "@prisma/client": "5.5.2",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^20.7.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "eslint": "^8.53.0",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-config": "^5.0.3",
    "nodemon": "^3.0.1",
    "octokit": "^3.1.2",
    "prisma": "^5.5.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/typescript": "4.0.1",
    "@graphql-codegen/typescript-document-nodes": "4.0.1",
    "@graphql-codegen/typescript-resolvers": "4.0.1"
  }
}
