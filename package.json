{
  "name": "kanban-metrics-backend",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": ". $NVM_DIR/nvm.sh nvm install && rm -rf node_modules/ && yarn",
    "dev": "nodemon",
    "test": "jest",
    "start:tsx": "tsx src/app.ts",
    "start:tsnode": "node --experimental-specifier-resolution=node --loader ts-node/esm dist/app.js",
    "build": "tsc",
    "db:reset": "prisma migrate reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "lint": "eslint . --ext .js --ext .ts --ext .gql --ext .graphql",
    "lint:fix": "yarn lint -- --fix",
    "codegen": "graphql-codegen"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.5.2",
    "cors": "^2.8.5",
    "eslint": "^8.53.0",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-config": "^5.0.3",
    "node-fetch": "^3.3.2",
    "octokit": "^3.1.2"
  },
  "devDependencies": {
    "@apollo/client": "^3.8.8",
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/typed-document-node": "^5.0.7",
    "@graphql-codegen/typescript": "4.0.1",
    "@graphql-codegen/typescript-document-nodes": "4.0.1",
    "@graphql-codegen/typescript-operations": "4.0.1",
    "@graphql-codegen/typescript-resolvers": "4.0.1",
    "@graphql-eslint/eslint-plugin": "3.20.1",
    "@octokit/graphql-schema": "^14.42.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.7.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "nodemon": "^3.0.1",
    "prisma": "5.5.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.2.2"
  }
}
