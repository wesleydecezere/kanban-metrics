{
  "name": "kanban-metrics-backend",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json\" --exec \" ts-node ./src/index.ts\"",
    "build": "tsc",
    "nvm:latest": ". $NVM_DIR/nvm.sh && nvm install --lts && nvm alias latest lts/* && nvm use latest",
    "start": "yarn nvm:latest && ts-node ./src/index.ts",
    "migrate": "yarn nvm:latest && npx prisma migrate dev"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.5.2",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^20.7.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "nodemon": "^3.0.1",
    "prisma": "^5.5.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
