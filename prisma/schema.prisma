// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DimSprint {
  @@unique([startWeekId, endWeekId])
  id Int @id @default(autoincrement())
  number Int
  startWeekId Int 
  endWeekId Int

  startWeek DimYearWeek @relation(name: "StartYearWeek", fields: [startWeekId], references: [id])
  endWeek DimYearWeek @relation(name: "EndYearWeek", fields: [endWeekId], references: [id])
}

model DimYearWeek {
  @@unique([year, week])
  id Int @id @default(autoincrement())
  year Int
  week Int
  start DateTime @db.Date
  end DateTime @db.Date

  breakWeeks BreakWeek[] 

  startSprints DimSprint[] @relation("StartYearWeek")
  endSprints DimSprint[] @relation("EndYearWeek")
}

model BreakWeek {
  id Int @id

  DimYearWeek DimYearWeek @relation(fields: [id], references: [id])
}