model BoardField {
  id String @id
  name String

  systemField SystemField?
}

model SystemField {
  id Int @id @default(autoincrement())
  name SystemFieldName
  boardFieldId String @unique

  boardField BoardField @relation(fields: [boardFieldId], references: [id])

  // evolutions IssueEvolutionField[]
}

enum SystemFieldName {
  POSITION
  POINTS_ESTIMATE
  DONE_PERCENTAGE
}