// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sprint {
  @@unique([startWeekId, endWeekId])
  id Int @id @default(autoincrement())
  number Int
  startWeekId Int 
  endWeekId Int

  startWeek YearWeek @relation(name: "StartYearWeek", fields: [startWeekId], references: [id])
  endWeek YearWeek @relation(name: "EndYearWeek", fields: [endWeekId], references: [id])

  issues IssueSprint[]
}

model YearWeek {
  @@unique([year, week])
  id Int @id @default(autoincrement())
  year Int
  week Int
  start DateTime @db.Date
  end DateTime @db.Date

  startSprints Sprint[] @relation("StartYearWeek")
  endSprints Sprint[] @relation("EndYearWeek")
}

model Issue {
  id String @id
  number Int
  title String

  sprints IssueSprint[]
  evolutions IssueEvolution[]
}

// https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/many-to-many-relations
model IssueSprint {
  // @@unique([issueId, sprintId])
  @@id([issueId, sprintId])
  // id Int @default(autoincrement())
  issueId String
  sprintId Int

  issue Issue @relation(fields: [issueId], references: [id])
  sprint Sprint @relation(fields: [sprintId], references: [id])
}

model IssueEvolution {
  id Int @id @default(autoincrement())
  issueId String

  date DateTime @db.Date
  // TODO replace by status
  position String
  donePercentage Int?
  pointsEstimate Int?

  issue Issue @relation(fields: [issueId], references: [id])

  // fields IssueEvolutionField[]
}

