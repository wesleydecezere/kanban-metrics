// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sprint {
  @@unique([startWeekId, endWeekId])
  id Int @id @default(autoincrement())
  number Int
  startWeekId Int 
  endWeekId Int

  startWeek YearWeek @relation(name: "StartYearWeek", fields: [startWeekId], references: [id])
  endWeek YearWeek @relation(name: "EndYearWeek", fields: [endWeekId], references: [id])
}

model YearWeek {
  @@unique([year, week])
  id Int @id @default(autoincrement())
  year Int
  week Int
  start DateTime @db.Date
  end DateTime @db.Date

  startSprints Sprint[] @relation("StartYearWeek")
  endSprints Sprint[] @relation("EndYearWeek")
}

model BreakWeek {
  @@unique([year, week])
  id Int @id @default(autoincrement())
  year Int
  week Int
}