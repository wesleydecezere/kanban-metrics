  "compilerOptions": {
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "prisma",
    "dist",
    "src/generated/graphql/types.ts" // TODO fix ignore generated
  ]
}
